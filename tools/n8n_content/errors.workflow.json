{
  "name": "Crush.lu v2 - Durable error inbox",
  "active": false,
  "nodes": [
    {
      "id": "error-trigger",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "sanitize-error-envelope",
      "name": "Sanitize Error Envelope",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        0
      ],
      "parameters": {
        "jsCode": "const execution=$json.execution || {}, error=execution.error || $json.trigger?.error || {};\nreturn [{json:{workflow:$json.workflow?.name || 'unknown',execution:execution.id || 'trigger-failure',\nnode:execution.lastNodeExecuted || error.node?.name || 'trigger',message:error.message || 'Workflow failed',stack:error.stack || ''}}];"
      }
    },
    {
      "id": "persist-dead-letter",
      "name": "Persist Dead Letter",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        400,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://content-review:8093/errors",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Crush Review Bearer"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Sanitize Error Envelope",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sanitize Error Envelope": {
      "main": [
        [
          {
            "node": "Persist Dead Letter",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Luxembourg",
    "executionTimeout": 240,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "saveManualExecutions": true
  }
}