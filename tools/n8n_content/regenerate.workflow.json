{
  "name": "Crush.lu v2 - Regenerate reviewed cover",
  "active": false,
  "nodes": [
    {
      "id": "regenerate-webhook",
      "name": "Regenerate Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "crush-visual-regenerate-v2",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Crush Regeneration Webhook"
        }
      }
    },
    {
      "id": "validate-review-id",
      "name": "Validate Review ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        0
      ],
      "parameters": {
        "jsCode": "const id=$json.body?.review_id;\nif(!/^[0-9a-f]{32}$/.test(id || '')) throw new Error('Invalid review ID');\nreturn [{json:{review_id:id}}];"
      }
    },
    {
      "id": "load-review",
      "name": "Load Review",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        400,
        0
      ],
      "parameters": {
        "url": "={{ 'http://content-review:8093/reviews/' + $json.review_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Crush Review Bearer"
        }
      }
    },
    {
      "id": "load-mascot-reference",
      "name": "Load Mascot Reference",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://content-renderer:8092/reference",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { ghostScene: $('Load Review').first().json.script.ghostScene } }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Crush Renderer Bearer"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "id": "prepare-reference-binary",
      "name": "Prepare Reference Binary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        0
      ],
      "parameters": {
        "jsCode": "const raw = $json.image_base64;\nif (!raw) throw new Error('Renderer returned no reference');\nconst reference = await this.helpers.prepareBinaryData(Buffer.from(raw,'base64'), 'reference.png', 'image/png');\nreturn [{json:$json, binary:{reference}}];"
      }
    },
    {
      "id": "generate-grounded-cover",
      "name": "Generate Grounded Cover",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "resource": "image",
        "operation": "edit",
        "modelId": {
          "__rl": true,
          "value": "models/gemini-2.5-flash-image",
          "mode": "list"
        },
        "prompt": "={{ $('Load Review').first().json.script.visualPrompt + ' Preserve the reference mascot exactly. No letters, logos or watermark. Square composition.' + ' Create a new composition and lighting; retain character identity. Variation ' + $execution.id }}",
        "images": {
          "values": [
            {
              "binaryPropertyName": "reference"
            }
          ]
        },
        "options": {
          "binaryPropertyOutput": "cover"
        }
      },
      "credentials": {
        "googlePalmApi": {
          "name": "Crush Gemini API"
        }
      }
    },
    {
      "id": "prepare-render-request",
      "name": "Prepare Render Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        0
      ],
      "parameters": {
        "jsCode": "const cover = await this.helpers.getBinaryDataBuffer(0, 'cover');\nconst previous = $('Load Review').first().json;\nreturn [{json:{...previous,cover_base64:cover.toString('base64')}}];"
      }
    },
    {
      "id": "render-complete-deck",
      "name": "Render Complete Deck",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1600,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://content-renderer:8092/render",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {script:$json.script,cover_base64:$json.cover_base64} }}",
        "options": {
          "timeout": 60000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Crush Renderer Bearer"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "id": "store-and-send-review",
      "name": "Store and Send Review",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1800,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://content-review:8093/deliver",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { script: $('Load Review').first().json.script, images:$json.images, run_key: `${$workflow.id}:${$execution.id}`, review_id:$('Load Review').first().json.review_id } }}",
        "options": {
          "timeout": 180000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Crush Review Bearer"
        }
      }
    }
  ],
  "connections": {
    "Regenerate Webhook": {
      "main": [
        [
          {
            "node": "Validate Review ID",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Review ID": {
      "main": [
        [
          {
            "node": "Load Review",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Load Review": {
      "main": [
        [
          {
            "node": "Load Mascot Reference",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Load Mascot Reference": {
      "main": [
        [
          {
            "node": "Prepare Reference Binary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Reference Binary": {
      "main": [
        [
          {
            "node": "Generate Grounded Cover",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Grounded Cover": {
      "main": [
        [
          {
            "node": "Prepare Render Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Render Request": {
      "main": [
        [
          {
            "node": "Render Complete Deck",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Render Complete Deck": {
      "main": [
        [
          {
            "node": "Store and Send Review",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Luxembourg",
    "executionTimeout": 240,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "none",
    "saveManualExecutions": false,
    "errorWorkflow": "__ERROR_WORKFLOW_ID__"
  }
}