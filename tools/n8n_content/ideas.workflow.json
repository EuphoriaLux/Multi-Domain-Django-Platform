{
  "name": "Crush.lu v2 - Luxembourg idea feed",
  "active": false,
  "nodes": [
    {
      "id": "refresh-ideas-manually",
      "name": "Refresh Ideas Manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "daily-source-refresh",
      "name": "Daily Source Refresh",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 8,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "id": "authenticated-refresh",
      "name": "Authenticated Refresh",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "crush-ideas-refresh-v2",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Crush Generation Webhook"
        }
      }
    },
    {
      "id": "collect-luxembourg-sources",
      "name": "Collect Luxembourg Sources",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        200,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://content-ideas:8094/refresh",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {} }}",
        "options": {
          "timeout": 550000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Crush Review Bearer"
        }
      }
    },
    {
      "id": "check-feed-result",
      "name": "Check Feed Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        0
      ],
      "parameters": {
        "jsCode": "if ($json.status==='no_fresh_facts') throw new Error('No fresh source facts collected; generator will use evergreen fallback');\nreturn [{json:$json}];"
      }
    }
  ],
  "connections": {
    "Refresh Ideas Manually": {
      "main": [
        [
          {
            "node": "Collect Luxembourg Sources",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Daily Source Refresh": {
      "main": [
        [
          {
            "node": "Collect Luxembourg Sources",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Authenticated Refresh": {
      "main": [
        [
          {
            "node": "Collect Luxembourg Sources",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Collect Luxembourg Sources": {
      "main": [
        [
          {
            "node": "Check Feed Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Luxembourg",
    "executionTimeout": 600,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "saveManualExecutions": true,
    "errorWorkflow": "__ERROR_WORKFLOW_ID__"
  }
}