#: delegations/templates/account/login_delegation.html:6
#: delegations/templates/account/login_delegation.html:15
msgid "Sign In"
msgstr "Connexion"

#: delegations/templates/account/login_delegation.html:16
msgid "Sign in with your Microsoft work account to access the delegation portal."
msgstr "Connectez-vous avec votre compte professionnel Microsoft pour accéder au portail de la délégation."

#: delegations/templates/account/login_delegation.html:25
#: delegations/templates/account/password_reset_delegation.html:26
msgid "Sign in with Microsoft"
msgstr "Se connecter avec Microsoft"

#: delegations/templates/account/login_delegation.html:30
#: delegations/templates/account/password_reset_delegation.html:31
msgid "Microsoft authentication is not configured. Please contact the administrator."
msgstr "L'authentification Microsoft n'est pas configurée. Veuillez contacter l'administrateur."

#: delegations/templates/account/logout_delegation.html:4
#: delegations/templates/account/logout_delegation.html:13
#: delegations/templates/account/logout_delegation.html:23
msgid "Sign Out"
msgstr "Se déconnecter"

#: delegations/templates/account/logout_delegation.html:14
msgid "Are you sure you want to sign out?"
msgstr "Êtes-vous sûr de vouloir vous déconnecter ?"

#: delegations/templates/account/logout_delegation.html:24
msgid "Cancel"
msgstr "Annuler"

#: delegations/templates/account/password_change_delegation.html:6
#: delegations/templates/account/password_change_delegation.html:14
msgid "Change Password"
msgstr "Changer le mot de passe"

#: delegations/templates/account/password_change_delegation.html:15
msgid "Delegations.lu uses Microsoft sign-in, so there is no password to change here. To change your password, use your organisation's Microsoft account."
msgstr "Delegations.lu utilise la connexion Microsoft, il n'y a donc aucun mot de passe à modifier ici. Pour modifier votre mot de passe, utilisez le compte Microsoft de votre organisation."

#: delegations/templates/account/password_change_delegation.html:16
msgid "Back"
msgstr "Retour"

#: delegations/templates/account/password_reset_delegation.html:7
#: delegations/templates/account/password_reset_delegation.html:16
msgid "Password Reset"
msgstr "Réinitialisation du mot de passe"

#: delegations/templates/account/password_reset_delegation.html:17
msgid "Delegations.lu uses Microsoft sign-in, so there is no password to reset here. If you cannot sign in, reset your password through your organisation's Microsoft account."
msgstr "Delegations.lu utilise la connexion Microsoft, il n'y a donc aucun mot de passe à réinitialiser ici. Si vous ne parvenez pas à vous connecter, réinitialisez votre mot de passe via le compte Microsoft de votre organisation."

#: delegations/templates/admin/base_site.html:4
#: delegations/templates/admin/base_site.html:29
msgid "Delegations.lu Management"
msgstr "Gestion Delegations.lu"
