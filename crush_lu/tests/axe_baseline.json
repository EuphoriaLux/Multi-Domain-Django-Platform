{
  "advent/dark": {
    "aria-progressbar-name": [
      ".progress-bar"
    ]
  },
  "advent/light": {
    "aria-progressbar-name": [
      ".progress-bar"
    ]
  },
  "connect-hub/dark": {
    "color-contrast": [
      ".connect-local-nav > a[href$=\"home/\"]",
      "a[href$=\"chats/\"]",
      "a[href$=\"inbox/\"]",
      "a[href$=\"week/\"]"
    ]
  },
  "connect-hub/light": {
    "color-contrast": [
      ".connect-local-nav > a[href$=\"home/\"]",
      ".connect-week-timeline-next",
      ".connect-week-timeline-step:nth-child(2) > .connect-week-timeline-label",
      ".connect-week-timeline-step:nth-child(3) > .connect-week-timeline-label",
      ".connect-week-timeline-step:nth-child(4) > .connect-week-timeline-label",
      ".connect-week-timeline-step:nth-child(5) > .connect-week-timeline-label",
      ".is-current > .connect-week-timeline-label",
      ".tracking-\\[0\\.12em\\]",
      "a[href$=\"chats/\"]",
      "a[href$=\"inbox/\"]",
      "time"
    ]
  },
  "dashboard/dark": {
    "color-contrast": [
      ".tracking-\\[0\\.08em\\]"
    ]
  },
  "dashboard/light": {
    "color-contrast": [
      ".tracking-\\[0\\.08em\\]",
      ".truncate.dark\\:text-gray-400.text-gray-500"
    ]
  },
  "event-detail/dark": {
    "color-contrast": [
      ".underline.font-semibold[href$=\"signup/\"]",
      "a[href=\"/en/login/?next=/en/events/N/\"]"
    ]
  },
  "event-detail/light": {
    "color-contrast": [
      ".gap-1\\.5.inline-flex.font-semibold > .text-green-600.dark\\:text-green-300",
      ".underline.font-semibold[href$=\"signup/\"]",
      "a[href=\"/en/login/?next=/en/events/N/\"]"
    ]
  },
  "events/light": {
    "color-contrast": [
      ".badge-crush-soft",
      ".gap-1\\.5.inline-flex:nth-child(1)",
      ".gap-1\\.5.inline-flex:nth-child(2)",
      ".text-green-600"
    ]
  },
  "login/dark": {
    "color-contrast": [
      ".hover\\:text-purple-700"
    ]
  },
  "login/light": {
    "color-contrast": [
      ".mt-6 > .text-gray-500.dark\\:text-gray-400"
    ]
  },
  "signup/dark": {
    "color-contrast": [
      ".font-normal",
      ".hover\\:underline[href$=\"privacy-policy/\"][target=\"_blank\"]",
      ".hover\\:underline[href$=\"terms-of-service/\"][target=\"_blank\"]"
    ]
  },
  "signup/light": {
    "color-contrast": [
      ".font-normal",
      ".hover\\:underline[href$=\"privacy-policy/\"][target=\"_blank\"]",
      ".hover\\:underline[href$=\"terms-of-service/\"][target=\"_blank\"]",
      ".items-start > .text-gray-500.dark\\:text-gray-400",
      ".mt-6 > .text-gray-500.dark\\:text-gray-400",
      ".password-strength-default"
    ]
  }
}
