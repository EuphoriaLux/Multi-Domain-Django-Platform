msgstr "vérifié via un mot de passe à usage unique (OTP) par SMS Firebase"

msgid "your city or region in Luxembourg"
msgstr "votre ville ou région au Luxembourg"

msgid "a short description of yourself (up to 500 characters)"
msgstr "une courte description de vous-même (jusqu'à 500 caractères)"

msgid "your hobbies and interests"
msgstr "vos loisirs et centres d'intérêt"

msgid "friends, dating, both, or networking"
msgstr "amis, rencontres, les deux ou réseautage"

msgid "Language preferences"
msgstr "Préférences linguistiques"

msgid "preferred interface language and languages spoken at events"
msgstr "langue d'interface préférée et langues parlées lors des événements"

