msgstr ""
"Registrierungsdetails: Veranstaltung, Status (ausstehend, bestätigt, "
"Warteliste, storniert, teilgenommen, nicht erschienen)"

msgid "Accessibility needs and dietary restrictions (if applicable)"
msgstr ""
"Barrierefreiheitsbedürfnisse und Ernährungseinschränkungen (falls zutreffend)"

msgid "Guest information: whether you are bringing a guest, guest name"
msgstr "Gastinformationen: ob Sie einen Gast mitbringen, Gastname"

msgid "Special requests"
msgstr "Besondere Wünsche"

msgid "Payment status and date (for paid events)"
msgstr "Zahlungsstatus und -datum (für kostenpflichtige Veranstaltungen)"

msgid "Check-in data: signed QR token and check-in timestamp"
msgstr "Check-in-Daten: signierter QR-Token und Check-in-Zeitstempel"

msgid ""
"Event invitations: guest email, name, invitation status, coach approval notes"
msgstr ""
"Veranstaltungseinladungen: Gast-E-Mail, Name, Einladungsstatus, Coach-"
"Genehmigungsnotizen"

msgid ""
"Activity voting and presentation ratings (ratings are anonymous to other "
