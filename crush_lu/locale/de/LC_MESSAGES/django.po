#: templates/crush_lu/includes/event_card.html:47
#: templates/crush_lu/includes/event_card.html:126
#: templates/crush_lu/partials/_products.html:32
msgid "Free"
msgstr "Frei"

#: templates/crush_lu/crush_connect.html:224
msgid ""
"LuxID-verified and discoverable — receive and answer Sparks, no subscription."
msgstr ""
