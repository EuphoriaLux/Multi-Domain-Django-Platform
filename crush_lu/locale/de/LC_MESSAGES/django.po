#: templates/crush_lu/crush_connect/_connect_subnav.html:26
#: templates/crush_lu/crush_connect/experiences/in-the-mix.html:5
#: templates/crush_lu/crush_connect/experiences/in-the-mix.html:16
#: views_crush_connect.py:1395
msgid "In the Mix"
msgstr "In the Mix"

