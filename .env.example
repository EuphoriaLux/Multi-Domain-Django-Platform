# =============================================================================
# ENVIRONMENT VARIABLES - Entreprinder Multi-Domain Application
# =============================================================================
# Copy this file to .env for local development
# Production variables are set in Azure Portal (App Service > Configuration)

# =============================================================================
# LOCAL DEVELOPMENT (required for runserver)
# =============================================================================

# Django secret key - generate a new one for production!
SECRET_KEY=your-development-secret-key-change-in-production

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Option 1: SQLite (default - no config needed)
# Option 2: Docker PostgreSQL (recommended for production-like testing)
# Uncomment the following to use the Docker PostgreSQL:
# DBNAME=entreprinder
# DBHOST=localhost
# DBUSER=postgres
# DBPASS=localdev
# DBPORT=5432

# -----------------------------------------------------------------------------
# Azure Storage Emulation (Azurite)
# -----------------------------------------------------------------------------
# Enable Azurite mode to use Docker-based Azure Blob Storage emulator
# This mimics production Azure Blob Storage locally
# Requires: docker-compose up -d azurite
# USE_AZURITE=true

# Note: When USE_AZURITE=true, the following are auto-configured:
# - Account: devstoreaccount1 (Azurite well-known credentials)
# - Endpoint: http://127.0.0.1:10000/devstoreaccount1
# - Containers: media (public), crush-profiles-private (private)

# -----------------------------------------------------------------------------
# Email Backend
# -----------------------------------------------------------------------------
# For local development, use console backend (emails print to terminal)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Cache - optional for local dev (Django uses LocMemCache by default)
# CACHELOCATION=redis://localhost:6379/0

# =============================================================================
# PRODUCTION ONLY (Azure App Service)
# =============================================================================
# These are configured in Azure Portal, NOT in local .env

# --- Core Django ---
# WEBSITE_HOSTNAME=django-app-xxx.azurewebsites.net  (auto-set by Azure)
# DJANGO_SETTINGS_MODULE=azureproject.production
# CUSTOM_DOMAINS=crush.lu,powerup.lu,vinsdelux.com,www.crush.lu,www.powerup.lu,www.vinsdelux.com
# ALLOWED_HOSTS_ENV=crush.lu,powerup.lu,vinsdelux.com,django-app-xxx.azurewebsites.net

# --- Database (Azure PostgreSQL) ---
# AZURE_POSTGRESQL_CONNECTIONSTRING=dbname=pythonapp host=xxx.postgres.database.azure.com port=5432 sslmode=require user=postgresadmin password=xxx

# --- Azure Blob Storage ---
# AZURE_ACCOUNT_NAME=mediaxxxxx
# AZURE_ACCOUNT_KEY=xxxxx
# AZURE_CONTAINER_NAME=media  # Legacy container (backward compatibility)
#
# Platform-specific containers (optional, defaults provided):
# AZURE_CRUSH_MEDIA_CONTAINER=crush-lu-media
# AZURE_CRUSH_PRIVATE_CONTAINER=crush-profiles-private  # Legacy: crush-profiles-private (current production)
#                                                        # New: crush-lu-private (recommended after migration)
# AZURE_VINSDELUX_MEDIA_CONTAINER=vinsdelux-media
# AZURE_VINSDELUX_PRIVATE_CONTAINER=vinsdelux-private
# AZURE_ENTREPRINDER_MEDIA_CONTAINER=entreprinder-media
# AZURE_POWERUP_MEDIA_CONTAINER=powerup-media
# AZURE_POWERUP_FINOPS_CONTAINER=powerup-finops
# AZURE_SHARED_MEDIA_CONTAINER=shared-media

# --- Application Insights (SDK-based with exception filtering) ---
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=xxx;IngestionEndpoint=https://westeurope-5.in.applicationinsights.azure.com/;LiveEndpoint=https://westeurope.livediagnostics.monitor.azure.com/
# ApplicationInsightsAgent_EXTENSION_VERSION=disabled  # REQUIRED: Disable autoinstrumentation for SDK filtering to work

# --- Email (Microsoft Graph API) ---
# GRAPH_TENANT_ID=xxx
# GRAPH_CLIENT_ID=xxx
# GRAPH_CLIENT_SECRET=xxx
# CRUSH_DEFAULT_FROM_EMAIL=noreply@crush.lu
# POWERUP_DEFAULT_FROM_EMAIL=info@powerup.lu
# VINSDELUX_DEFAULT_FROM_EMAIL=info@vinsdelux.com

# --- OAuth Providers ---
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxx
# MICROSOFT_CLIENT_ID=xxx
# MICROSOFT_CLIENT_SECRET=xxx

# --- Push Notifications (Web Push / VAPID) ---
# VAPID_PUBLIC_KEY=xxx
# VAPID_PRIVATE_KEY=xxx
# VAPID_ADMIN_EMAIL=noreply@crush.lu

# --- Firebase (Phone Auth) ---
# FIREBASE_PROJECT_ID=project-xxx
# FIREBASE_API_KEY=AIzaSyxxx
# FIREBASE_AUTH_DOMAIN=project-xxx.firebaseapp.com

# --- Android App Links (Play Store signing) ---
# Drives /.well-known/assetlinks.json. Comma-separated SHA-256 fingerprints of
# the Play app signing certificate(s). Empty (the default) serves a web-only
# assetlinks, so Android App Links verification fails closed until this is set.
# Get the fingerprint from Play Console > App integrity > App signing. Required
# for https://crush.lu/... links to open in the app rather than the browser.
# ANDROID_APP_SHA256_CERT_FINGERPRINTS=AB:CD:EF:01:23:45:67:89:AB:CD:EF:01:23:45:67:89:AB:CD:EF:01:23:45:67:89:AB:CD:EF:01:23:45:67:89

# --- WhatsApp Cloud API (Meta) ---
# Server-side only. Drives /hub/whatsapp/* and /api/webhooks/whatsapp/.
# Get the access token from the Meta dashboard ("Generate token" on the WhatsApp
# use-case setup page). META_WHATSAPP_VERIFY_TOKEN is a free string you choose
# and mirror in the Meta webhook configuration UI.
# META_WHATSAPP_ACCESS_TOKEN=EAAxxx
# META_PHONE_NUMBER_ID=1068519436346814
# META_WABA_ID=1429885365004439
# META_WHATSAPP_APP_SECRET=xxx
# META_WHATSAPP_VERIFY_TOKEN=pick-any-string
# WhatsApp phone-verification (OTP). Template name is
# "<prefix>_phone_verification", one per language (en/de/fr) under that name.
# Use a staging prefix on staging WABAs, "crush" in production. TTL minutes must
# match the template's expiration + message validity period in WhatsApp Manager.
# WHATSAPP_OTP_TEMPLATE_PREFIX=crush_staging
# WHATSAPP_OTP_TTL_MINUTES=3

# --- Hub social-media marketing planner ---
# Server-side only. Claude uses structured JSON output; Buffer uses the current
# GraphQL API. BUFFER_ORGANIZATION_ID is optional when the key has exactly one
# organization. Generated media URLs must be publicly reachable by Buffer.
# ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_TIMEOUT_SECONDS=60
# BUFFER_API_KEY=buffer-personal-key
# BUFFER_ORGANIZATION_ID=org_xxx
# BUFFER_TIMEOUT_SECONDS=20
# BACKEND_BASE_URL=https://api.crush.lu

# --- echo.lu event sync (Luxembourg national events portal) ---
# API key is issued per organisation from the echo.lu organiser back office.
# Staging should point at the sandbox (https://test-api.echo.lu/v1) with a
# sandbox key — keys are not interchangeable between the two environments.
# ECHO_LU_SYNC_ENABLED defaults to false; nothing is published until it is on.
# ECHO_LU_API_KEY=xxx
# ECHO_LU_API_BASE_URL=https://api.echo.lu/v1
# ECHO_LU_SYNC_ENABLED=false
# ECHO_LU_TIMEOUT_SECONDS=20
# ECHO_LU_CONTACT_NAME=Crush.lu
# ECHO_LU_CONTACT_COMPANY=Crush.lu
# ECHO_LU_CONTACT_EMAIL=hello@crush.lu
# ECHO_LU_CONTACT_PHONE=+352xxxxxxxx
# ECHO_LU_CONTACT_WEBSITE=https://crush.lu
# Taxonomy slugs must exist in echo.lu's vocabularies or the whole experience
# is rejected. Run `python manage.py echo_taxonomy` to list the valid values.
# ECHO_LU_DEFAULT_CATEGORIES=
# ECHO_LU_DEFAULT_AUDIENCES=
# ECHO_LU_DEFAULT_FORMATS=
# ECHO_LU_DEFAULT_ENVIRONMENTS=
# ECHO_LU_DEFAULT_TAGS=crush.lu
# ECHO_LU_CATEGORY_MAP={"speed_dating": ["..."], "quiz_night": ["..."]}

# --- Analytics ---
# GA4_CRUSH_LU=G-xxx
# GA4_POWERUP=G-xxx
# GA4_ARBORIST=G-xxx

# --- Delegations.lu ---
# DELEGATION_GRAPH_CLIENT_ID=xxx
# DELEGATION_GRAPH_CLIENT_SECRET=xxx

# =============================================================================
# GITHUB ACTIONS / CI
# =============================================================================
# These are set as GitHub Secrets (Settings > Secrets and variables > Actions)
#
# Required for deployment:
#   AZUREAPPSERVICE_CLIENTID_xxx     - Service Principal Client ID
#   AZUREAPPSERVICE_TENANTID_xxx     - Azure AD Tenant ID
#   AZUREAPPSERVICE_SUBSCRIPTIONID_xxx - Azure Subscription ID
#
# Optional (has fallback):
#   SECRET_KEY                        - Django secret key for CI tests
